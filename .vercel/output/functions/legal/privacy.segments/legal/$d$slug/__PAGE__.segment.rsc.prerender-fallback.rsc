3:["$","td","1",{"className":"border-b border-border px-3 py-2.5 text-[13px] text-text-secondary","children":"Security, abuse prevention, and session management."}]
4:["$","tr","3",{"children":[["$","td","0",{"className":"border-b border-border px-3 py-2.5 font-mono text-[12px] text-text-primary","children":"Aggregate usage metrics"}],["$","td","1",{"className":"border-b border-border px-3 py-2.5 text-[13px] text-text-secondary","children":"Capacity planning. Never tied to message content."}]]}]
5:["$","h2","4",{"className":"mt-6 border-t border-border pt-8 text-[22px] font-semibold leading-[1.3] tracking-[-0.01em] text-text-primary","children":"What we don't do"}]
6:["$","p","5",{"className":"text-[15px] leading-[1.75] text-text-secondary","children":"We do not read your messages, scan attachments for advertising signals, build behavioral profiles, or train machine-learning models on customer content. Crash reports and diagnostics are opt-in."}]
7:["$","h2","6",{"className":"mt-6 border-t border-border pt-8 text-[22px] font-semibold leading-[1.3] tracking-[-0.01em] text-text-primary","children":"Self-hosted instances"}]
8:["$","p","7",{"className":"text-[15px] leading-[1.75] text-text-secondary","children":"On your own instance, all data lives on your hardware. The only outbound request the software makes is a version check against our update server, and you can disable it with one environment variable. We receive no usage data, no account data, and no content from self-hosted deployments."}]
9:["$","h2","8",{"className":"mt-6 border-t border-border pt-8 text-[22px] font-semibold leading-[1.3] tracking-[-0.01em] text-text-primary","children":"Retention and deletion"}]
a:["$","p","9",{"className":"text-[15px] leading-[1.75] text-text-secondary","children":"Hosted data is retained while your account is active. Deleting a message removes it for everyone; deleting your account removes your data within 30 days, with encrypted backups aging out within 90. Export is available from Settings at any time."}]
b:["$","h2","10",{"className":"mt-6 border-t border-border pt-8 text-[22px] font-semibold leading-[1.3] tracking-[-0.01em] text-text-primary","children":"Your rights"}]
c:["$","p","11",{"className":"text-[15px] leading-[1.75] text-text-secondary","children":"Depending on where you live, you may have rights to access, correct, port, or erase your data (GDPR, CCPA, and similar). Write to privacy@corvus.app and we'll handle it — no forms, no dark patterns."}]
