ate information and keep your credentials secure."]}],["$","li","1",{"className":"flex gap-3 text-[15px] leading-[1.65] text-text-secondary","children":[["$","span",null,{"aria-hidden":true,"className":"shrink-0 font-mono text-[13px] leading-[1.8] text-text-muted","children":"—"}],"You are responsible for activity under your account, including API keys you create."]}],["$","li","2",{"className":"flex gap-3 text-[15px] leading-[1.65] text-text-secondary","children":[["$","span",null,{"aria-hidden":true,"className":"shrink-0 font-mono text-[13px] leading-[1.8] text-text-muted","children":"—"}],"Accounts may not be shared, sold, or transferred without our written consent."]}]]}],["$","h2","4",{"className":"mt-6 border-t border-border pt-8 text-[22px] font-semibold leading-[1.3] tracking-[-0.01em] text-text-primary","children":"3. Acceptable use"}],["$","p","5",{"className":"text-[15px] leading-[1.75] text-text-secondary","children":"Don't use AIIC to break the law, to harass people, to distribute malware, or to disrupt the service or other users. We may suspend accounts that do. On self-hosted instances, the instance owner sets and enforces their own acceptable-use rules."}],["$","h2","6",{"className":"mt-6 border-t border-border pt-8 text-[22px] font-semibold leading-[1.3] tracking-[-0.01em] text-text-primary","children":"4. Your content"}],["$","p","7",{"className":"text-[15px] leading-[1.75] text-text-secondary","children":"You own what you post. You grant us only the rights needed to store, transmit, and display your content to the people you share it with — nothing more. We do not mine your messages for advertising or train models on your data."}],["$","h2","8",{"className":"mt-6 border-t border-border pt-8 text-[22px] font-semibold leading-[1.3] tracking-[-0.01em] text-text-primary","children":"5. Self-hosted instances"}],"$L3","$L4","$L5","$L6","$L7","$L8","$L9","$La"]}]]}]}],"$Lb"]}],null,"$Lc"]}],"isPartial":false,"staleTime":300,"varyParams":null,"buildId":"A