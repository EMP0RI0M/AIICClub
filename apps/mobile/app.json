{
  "expo": {
    "name": "AIIC Club",
    "slug": "aiic-club",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "aiic",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#0A0B11"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "org.aiic.mobile"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0A0B11"
      },
      "package": "org.aiic.mobile",
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "https",
              "host": "aiic-bbs.vercel.app",
              "pathPrefix": "/join"
            },
            {
              "scheme": "https",
              "host": "aiic-bbs.vercel.app",
              "pathPrefix": "/invite"
            },
            {
              "scheme": "https",
              "host": "aiic-bbs.vercel.app",
              "pathPrefix": "/space"
            },
            {
              "scheme": "https",
              "host": "aiic-bbs.vercel.app",
              "pathPrefix": "/spaces"
            },
            {
              "scheme": "https",
              "host": "aiic-bbs.vercel.app",
              "pathPrefix": "/channels"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        }
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-font"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
