{
  "expo": {
    "name": "AIIC Club",
    "slug": "aiic-club",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "aiic",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "updates": {
      "enabled": false
    },
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#0A0B11"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "org.aiic.mobile",
      "infoPlist": {
        "NSMicrophoneUsageDescription": "AIIC needs microphone access for voice channels, voice messages, and audio calls.",
        "NSCameraUsageDescription": "AIIC needs camera access for video calls, avatar photos, and media attachments.",
        "NSPhotoLibraryUsageDescription": "AIIC needs photo library access for sharing images and attachments in chats.",
        "UIBackgroundModes": ["audio", "fetch", "remote-notification"]
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0A0B11"
      },
      "package": "org.aiic.mobile",
      "softwareKeyboardLayoutMode": "resize",
      "permissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.CAMERA",
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "android.permission.INTERNET",
        "android.permission.ACCESS_NETWORK_STATE",
        "android.permission.POST_NOTIFICATIONS",
        "android.permission.VIBRATE",
        "android.permission.WAKE_LOCK",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE"
      ],
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "https",
              "host": "aiic-bbs.vercel.app",
              "pathPrefix": "/join"
            },
            {
              "scheme": "https",
              "host": "aiic-bbs.vercel.app",
              "pathPrefix": "/invite"
            },
            {
              "scheme": "https",
              "host": "aiic-bbs.vercel.app",
              "pathPrefix": "/space"
            },
            {
              "scheme": "https",
              "host": "aiic-bbs.vercel.app",
              "pathPrefix": "/spaces"
            },
            {
              "scheme": "https",
              "host": "aiic-bbs.vercel.app",
              "pathPrefix": "/channels"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        }
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-font",
      [
        "expo-av",
        {
          "microphonePermission": "AIIC needs microphone access for voice channels, voice messages, and audio calls."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "AIIC needs photo library access for sharing images and attachments in chats.",
          "cameraPermission": "AIIC needs camera access for video calls, avatar photos, and media attachments."
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/icon.png",
          "color": "#E8A33D"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
